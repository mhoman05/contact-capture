{
  "id": "/",
  "name": "Pocket CRM",
  "short_name": "Pocket CRM",
  "description": "Your Notion CRM in your pocket: add people from a card photo, QR code or typing, follow up, share your contact card",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#f5f6f3",
  "theme_color": "#1f6f5c",
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "cards",
          "accept": [
            "image/*"
          ]
        }
      ]
    }
  },
  "shortcuts": [
    {
      "name": "Add a task",
      "short_name": "Add task",
      "url": "/?tab=tasks",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "People",
      "short_name": "People",
      "url": "/?tab=recent",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "My QR card",
      "short_name": "My QR",
      "url": "/?tab=qr",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ]
}
